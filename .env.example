# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Hosted TURN provider (e.g. Metered, Cloudflare, Twilio).
# Comma-separated TURN URLs; leave all three unset to run STUN-only.
# Preferred: a provider endpoint that mints fresh credentials. The apiKey stays
# server-side; only the short-lived username/credential reach the browser.
# TURN_API_URL=https://<your-app>.metered.live/api/v1/turn/credentials?apiKey=<your-api-key>

# Fallback static credentials. The URLs and the credentials MUST come from the
# SAME host — valid keys aimed at a different relay host are refused with a 400.
TURN_URLS=turn:example.relay.example.com:80,turns:example.relay.example.com:443?transport=tcp
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-credential

# Set to 1 to force all media through TURN (testing that TURN works).
# FORCE_RELAY=1

# Optional server-wide TMDb key for the metadata search (users can also enter
# their own key in Settings, which takes precedence via the x-tmdb-key header).
# TMDB_API_KEY=your-tmdb-api-key
