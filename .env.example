# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Hosted TURN provider (e.g. Metered, Cloudflare, Twilio).
# Comma-separated TURN URLs; leave all three unset to run STUN-only.
TURN_URLS=turn:example.relay.example.com:80,turns:example.relay.example.com:443?transport=tcp
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-credential

# Set to 1 to force all media through TURN (testing that TURN works).
# FORCE_RELAY=1
